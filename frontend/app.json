{
  "expo": {
    "name": "Jalaliya Juma Masjid",
    "slug": "jalaliya-juma-masjid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3D3E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jalaliya.masjid"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D3E"
      },
      "package": "com.jalaliya.masjid"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "title": "Jalaliya Juma Masjid"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
